{
  "name": "typod",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "fetch-feeds": "node --env-file-if-exists=.env scripts/fetch-feeds.ts",
    "build": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json && vite build",
    "build:full": "pnpm fetch-feeds && pnpm build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fast-xml-parser": "^5.8.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
